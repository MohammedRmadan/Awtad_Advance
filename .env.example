# ===== Awtad BD Hub – environment =====
# deploy/linux/install.sh writes this file for you. Edit it only if you know what you are changing,
# then apply with:  bdhub restart

# Public address users open. Must match exactly what is typed in the browser.
#   with a domain:  https://bdhub.awtad.com.sa      without a domain:  http://<server-ip>
BASE_URL=https://bdhub.awtad.com.sa
# Domain for automatic HTTPS (Let's Encrypt), or :80 to serve plain HTTP by IP
SITE_ADDRESS=bdhub.awtad.com.sa
TZ=Asia/Riyadh

# Database password (PostgreSQL inside Docker)        openssl rand -hex 24
POSTGRES_PASSWORD=
# Session signing secret, at least 32 characters       openssl rand -hex 32
SESSION_SECRET=
# Sign-in lasts this many hours
SESSION_HOURS=10

# ----- Username / password sign-in -----
# First administrator, created on first start only (must change the password at first sign-in)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=
# Lock an account for LOGIN_LOCK_MINUTES after LOGIN_MAX_ATTEMPTS wrong passwords
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10

# ----- Email notifications (optional) -----
# none = in-app notifications only | smtp = also send daily/weekly emails
MAIL_MODE=none
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Daily digest 07:00 Sun–Thu, weekly management summary Sunday 07:30 (Asia/Riyadh)
DIGEST_CRON=0 7 * * 0-4
WEEKLY_CRON=30 7 * * 0

# ----- Attachments and backups -----
MAX_UPLOAD_MB=25
MAX_BODY=30MB
BACKUP_KEEP_DAYS=30
